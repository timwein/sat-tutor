# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string (32+ chars) used to encrypt students' Anthropic API keys at rest.
# Generate one with: openssl rand -hex 32
# Changing it invalidates every stored key (students must re-enter them).
API_KEY_ENCRYPTION_SECRET=

# Comma-separated emails that get admin access (question bank management, /admin).
ADMIN_EMAILS=you@example.com

# Optional: require this code to create an account. Leave unset to allow open signup.
SIGNUP_INVITE_CODE=

# Random string used to sign parent-dashboard PIN sessions.
PARENT_ACCESS_SECRET=

# No longer needed: each student stores their own key in Settings.
# ANTHROPIC_API_KEY=
